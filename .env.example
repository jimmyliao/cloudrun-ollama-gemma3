# Required environment variables for the Cloud Run Ollama Gemma3 project

# Hugging Face token for accessing models
HUGGINGFACE_TOKEN=hf_your_token_here

# Google Cloud Platform settings
PROJECT_ID=your_gcp_project_id
REGION=us-central1

# Service configuration
SERVICE_NAME=your_service_name
REPO_NAME=your_repo_name

# Model configuration
# Available models include:
#  - gemma3:4b (smaller, faster)
#  - gemma3:27b-it-qat (larger, more capable, quantized for efficiency)
#  - gemma3:4b-it-qat (instruction-tuned, quantized)
#  - gemma3:12b-it-qat (medium size, instruction-tuned, quantized)
MODEL_NAME=gemma3:4b


# Optional: Override default settings
# MACHINE_TYPE=e2-highcpu-32
# GPU_TYPE=nvidia-l4
# TIMEOUT=3600