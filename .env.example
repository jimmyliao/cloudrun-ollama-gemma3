# Hugging Face Hub API Token (Read access required for Gemma)
HF_TOKEN="your-huggingface-read-token"

# Google Cloud Platform Configuration
PROJECT_ID="your-gcp-project-id"
REGION="your-gcp-region" # e.g., us-central1

# Cloud Run Service Configuration
SERVICE_NAME="ollama-gemma-rag-agent"

# Cloud Build Image Configuration
IMAGE_NAME="ollama-gemma-rag-image" # Just the image name, registry path constructed in Makefile
